# Prime CRM — Exemple de configuration (ne jamais commiter de secrets réels)
# Copiez ce fichier vers .env et remplissez avec vos valeurs

# Base de données PostgreSQL (Docker)
POSTGRES_USER=prime
POSTGRES_PASSWORD=change_this_to_strong_password
POSTGRES_DB=primecrm
POSTGRES_PORT=5432

# Backend
SECRET_KEY=please_generate_a_long_random_secret_key_here_min_32_chars
DATABASE_URL=postgresql://prime:change_this_to_strong_password@db:5432/primecrm
BACKEND_PORT=8000
FRONTEND_PORT=80
CORS_ORIGINS=http://localhost,http://localhost:80

# Premier administrateur (créé automatiquement au 1er démarrage si DB vide)
FIRST_SUPERUSER_EMAIL=admin@primevisionsolutions.tn
FIRST_SUPERUSER_PASSWORD=Admin123!
FIRST_COMPANY_NAME=Prime Vision Solutions

# Ollama local (optionnel, gratuit)
# En Docker, utilisez host.docker.internal pour joindre Ollama sur l'hôte
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# CodeCraftAPI (optionnel, compatible OpenAI) — laissez vide si non utilisé
# CODECRAFT_API_KEY=
# CODECRAFT_BASE_URL=https://www.codecraftapi.com/v1
# CODECRAFT_MODEL=gpt-4o-mini

# Redis (optionnel, profil with-redis)
# REDIS_PORT=6379
