# Exemple uniquement : ne jamais enregistrer ici de secrets réels.
# Copier vers .env (ignoré par Git) et renseigner des valeurs générées localement.

# PostgreSQL local Docker. Un mot de passe URL-safe évite les caractères
# spéciaux dans l'URL construite par docker-compose.yml.
POSTGRES_USER=prime
POSTGRES_PASSWORD=
POSTGRES_DB=primecrm
POSTGRES_PORT=5432

# Backend local. Production doit utiliser APP_ENV=production et PostgreSQL.
APP_ENV=development
SECRET_KEY=
DATABASE_URL=sqlite:///./prime_crm.db
BACKEND_PORT=8000
FRONTEND_PORT=80
CORS_ORIGINS=http://localhost:5173,http://localhost
ALLOW_PUBLIC_REGISTRATION=false

# Requis uniquement pour créer le premier administrateur sur une base vide.
# Renseigner dans .env ou l'environnement de l'hébergeur, jamais dans Git.
FIRST_SUPERUSER_EMAIL=
FIRST_SUPERUSER_PASSWORD=
FIRST_COMPANY_NAME=Prime Vision Solutions

# IA facultative : aucune destination autorisée par défaut.
# Origines HTTPS exactes séparées par des virgules, sans chemin ni secret ;
# exemple fictif : https://provider.example.invalid
AI_ALLOWED_ORIGINS=
# Ollama local non chiffré : uniquement développement isolé, jamais production.
AI_ALLOW_LOCAL_OLLAMA=false
# L'URL et le modèle Ollama se configurent dans le CRM, pas ici.

# Redis local pour le développement hors Docker ; jamais de secret ici.
# En production, REDIS_URL doit être un rediss:// authentifié, fourni par
# le gestionnaire de secrets de l'hébergeur. Compose dev utilise redis:6379.
REDIS_URL=redis://127.0.0.1:6379/0
# REDIS_PORT=6379
